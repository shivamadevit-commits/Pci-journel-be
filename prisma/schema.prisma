// PCI / DigiPharmed Journal Portal — database schema (PostgreSQL, Prisma 6)
// Timestamps are stored as timestamptz (UTC-safe). Money uses Decimal.
// Critical records (articles, reviews, decisions, publications, audit) are never cascade-deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  EDITOR
  REVIEWER
  AUTHOR
  PRODUCTION
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  EMAIL_VERIFICATION
}

enum ResetTokenPurpose {
  PASSWORD_RESET
  ACCOUNT_INVITE
}

enum ArticleStatus {
  SUBMITTED
  UNDER_EDITORIAL_SCREENING
  REJECTED_AT_SCREENING
  PLAGIARISM_CHECK
  READY_FOR_REVIEWER_ASSIGNMENT
  UNDER_REVIEW
  REVIEWS_RECEIVED
  UNDER_EDITORIAL_DECISION
  REVISION_REQUESTED // Extension: only reachable when revision-after-review is enabled (pending PCI confirmation)
  REJECTED
  ACCEPTED_PRODUCTION_PENDING
  IN_PRODUCTION
  PROOF_SENT_TO_AUTHOR
  CORRECTION_REQUIRED
  MAJOR_CONTENT_CHANGE_EDITOR_REVIEW
  FINAL_PRODUCTION
  PUBLISHED
}

enum FilePurpose {
  MANUSCRIPT
  TITLE_PAGE
  PLAGIARISM_REPORT
  PROOF
  FINAL_HTML
  FINAL_PDF
  REVIEWER_CV
}

enum VersionKind {
  ORIGINAL
  REVISION
}

enum ReviewerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewerAssignmentStatus {
  ASSIGNED
  SUBMITTED
  DECLINED
  REVOKED
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum ReviewReportStatus {
  DRAFT
  SUBMITTED
}

enum ReviewCommentSection {
  SUMMARY
  ORIGINALITY
  METHODOLOGY
  RESULTS
  ETHICS
  LANGUAGE
  OTHER
  CONFIDENTIAL_TO_EDITOR
}

enum DecisionType {
  PROCEED_TO_PLAGIARISM_CHECK
  REJECT_AT_SCREENING
  CLEAR_FOR_REVIEW
  REJECT_AFTER_PLAGIARISM
  ACCEPT
  REJECT
  REQUEST_REVISION
}

enum PlagiarismStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum PlagiarismVerdict {
  CLEAR
  CONCERN
}

enum PlagiarismSource {
  API
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  WAIVED
}

enum ProductionTaskStatus {
  PENDING
  IN_PROGRESS
  AWAITING_AUTHOR
  CORRECTIONS
  AWAITING_EDITOR
  FINALIZING
  COMPLETED
}

enum ProofAuthorStatus {
  PENDING_DELIVERY
  PENDING_REVIEW
  APPROVED
  CORRECTIONS_REQUESTED
  SUPERSEDED
}

enum CorrectionType {
  MINOR
  MAJOR
}

enum CorrectionStatus {
  OPEN
  IMPLEMENTED
  ESCALATED
  APPROVED_BY_EDITOR
  REJECTED_BY_EDITOR
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum EmailStatus {
  NOT_REQUIRED
  PENDING
  SENDING
  SENT
  FAILED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique // stored lowercased
  passwordHash      String
  firstName         String
  lastName          String
  role              Role
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?  @db.Timestamptz(6)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?  @db.Timestamptz(6)
  lastLoginAt       DateTime?  @db.Timestamptz(6)
  passwordChangedAt DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  authorProfile   AuthorProfile?
  editorProfile   EditorProfile?
  reviewerProfile ReviewerProfile?

  otps                         AuthOtp[]
  resetTokens                  PasswordResetToken[]
  sessions                     AuthSession[]
  notifications                Notification[]
  submittedArticles            Article[]              @relation("ArticleAuthor")
  editedArticles               Article[]              @relation("ArticleEditor")
  uploadedFiles                FileAsset[]
  auditLogs                    AuditLog[]
  productionTasks              ProductionTask[]       @relation("ProductionAssignee")
  statusChanges                ArticleStatusHistory[]
  decisions                    EditorialDecision[]
  versionsCreated              ManuscriptVersion[]
  reviewerApplicationsReviewed ReviewerApplication[]  @relation("ApplicationReviewer")
  configUpdates                SystemConfig[]

  @@index([role, status])
  @@index([status])
  @@index([lastName, firstName])
}

model AuthOtp {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime   @db.Timestamptz(6)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  purpose   ResetTokenPurpose @default(PASSWORD_RESET)
  tokenHash String            @unique
  expiresAt DateTime          @db.Timestamptz(6)
  usedAt    DateTime?         @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6) // set when rotated; reuse of a used token revokes the session
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AuthorProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  affiliation String?
  country     String?
  phone       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EditorProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  designation String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Reviewers ─────────────────────────────

model SubjectArea {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  reviewers    ReviewerSubjectArea[]
  articles     Article[]
  applications ReviewerApplicationSubjectArea[]
}

model ReviewerProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  reviewerCode         String   @unique // e.g. REV-000001
  institution          String?
  designation          String?
  highestQualification String?
  holdsMPharm          Boolean  @default(false)
  yearsTeaching        Int      @default(0)
  qualificationNotes   String?
  eligibilityNotes     String? // editor-only notes
  isActive             Boolean  @default(true)
  approvedAt           DateTime @default(now()) @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  subjectAreas ReviewerSubjectArea[]
  assignments  ReviewerAssignment[]

  @@index([isActive])
}

model ReviewerSubjectArea {
  reviewerId    String @db.Uuid
  subjectAreaId String @db.Uuid

  reviewer    ReviewerProfile @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  subjectArea SubjectArea     @relation(fields: [subjectAreaId], references: [id], onDelete: Restrict)

  @@id([reviewerId, subjectAreaId])
  @@index([subjectAreaId])
}

model ReviewerApplication {
  id                   String                    @id @default(uuid()) @db.Uuid
  email                String
  firstName            String
  lastName             String
  institution          String
  designation          String?
  highestQualification String
  holdsMPharm          Boolean                   @default(false)
  yearsTeaching        Int                       @default(0)
  statement            String
  cvFileId             String?                   @unique @db.Uuid
  status               ReviewerApplicationStatus @default(PENDING)
  reviewedById         String?                   @db.Uuid
  reviewedAt           DateTime?                 @db.Timestamptz(6)
  decisionNote         String?
  createdReviewerId    String?                   @db.Uuid
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(6)

  reviewedBy   User?                            @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  cvFile       FileAsset?                       @relation(fields: [cvFileId], references: [id], onDelete: Restrict)
  subjectAreas ReviewerApplicationSubjectArea[]

  @@index([status, createdAt])
  @@index([email])
}

model ReviewerApplicationSubjectArea {
  applicationId String @db.Uuid
  subjectAreaId String @db.Uuid

  application ReviewerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subjectArea SubjectArea         @relation(fields: [subjectAreaId], references: [id], onDelete: Restrict)

  @@id([applicationId, subjectAreaId])
}

// ───────────────────────────── Articles ─────────────────────────────

model Article {
  id                String        @id @default(uuid()) @db.Uuid
  submissionId      String        @unique // e.g. PCI-2026-000001
  title             String
  abstract          String
  ethicsStatement   String
  subjectAreaId     String?       @db.Uuid
  status            ArticleStatus @default(SUBMITTED)
  authorId          String        @db.Uuid // submitting author (account)
  editorId          String?       @db.Uuid // assigned editor
  currentWordCount  Int           @default(0)
  wordLimitExceeded Boolean       @default(false)
  screeningRejected Boolean       @default(false) // closed at screening; never reopens
  submittedAt       DateTime      @default(now()) @db.Timestamptz(6)
  acceptedAt        DateTime?     @db.Timestamptz(6)
  closedAt          DateTime?     @db.Timestamptz(6)
  publishedAt       DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  author      User         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editor      User?        @relation("ArticleEditor", fields: [editorId], references: [id], onDelete: Restrict)
  subjectArea SubjectArea? @relation(fields: [subjectAreaId], references: [id], onDelete: Restrict)

  coAuthors        ArticleAuthor[]
  keywords         ArticleKeyword[]
  versions         ManuscriptVersion[]
  files            FileAsset[]
  assignments      ReviewerAssignment[]
  decisions        EditorialDecision[]
  plagiarismChecks PlagiarismCheck[]
  payment          ApcPayment?
  productionTask   ProductionTask?
  proofs           ProofVersion[]
  corrections      Correction[]
  publication      Publication?
  statusHistory    ArticleStatusHistory[]

  @@index([status, submittedAt])
  @@index([authorId, submittedAt])
  @@index([editorId, status])
  @@index([subjectAreaId])
  @@index([title])
}

model ArticleAuthor {
  id              String  @id @default(uuid()) @db.Uuid
  articleId       String  @db.Uuid
  orderIndex      Int
  firstName       String
  lastName        String
  email           String
  affiliation     String?
  isCorresponding Boolean @default(false)

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([articleId, orderIndex])
  @@index([articleId])
  @@index([email])
}

model ArticleKeyword {
  id        String @id @default(uuid()) @db.Uuid
  articleId String @db.Uuid
  keyword   String

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([articleId, keyword])
  @@index([keyword])
}

model FileAsset {
  id           String      @id @default(uuid()) @db.Uuid
  articleId    String?     @db.Uuid
  purpose      FilePurpose
  storageKey   String      @unique // server-generated, never derived from the client filename
  originalName String // kept for staff reference only; never used as a path or in reviewer-facing output
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)

  article             Article?             @relation(fields: [articleId], references: [id], onDelete: Restrict)
  uploadedBy          User?                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  version             ManuscriptVersion?   @relation("VersionManuscript")
  titlePageOf         ManuscriptVersion?   @relation("VersionTitlePage")
  proof               ProofVersion?
  plagiarismReport    PlagiarismCheck?
  finalHtmlOf         Publication?         @relation("PublicationHtml")
  finalPdfOf          Publication?         @relation("PublicationPdf")
  reviewerApplication ReviewerApplication?

  @@index([articleId, purpose])
}

model ManuscriptVersion {
  id              String      @id @default(uuid()) @db.Uuid
  articleId       String      @db.Uuid
  versionNumber   Int
  kind            VersionKind @default(ORIGINAL)
  fileId          String      @unique @db.Uuid
  titlePageFileId String?     @unique @db.Uuid
  wordCount       Int
  changeNote      String?
  /// Plain text extracted lazily by the plagiarism engine; used as the internal comparison corpus.
  extractedText   String?
  createdById     String      @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)

  article          Article              @relation(fields: [articleId], references: [id], onDelete: Restrict)
  file             FileAsset            @relation("VersionManuscript", fields: [fileId], references: [id], onDelete: Restrict)
  titlePage        FileAsset?           @relation("VersionTitlePage", fields: [titlePageFileId], references: [id], onDelete: Restrict)
  createdBy        User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignments      ReviewerAssignment[]
  plagiarismChecks PlagiarismCheck[]

  @@unique([articleId, versionNumber])
}

model ArticleStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  articleId  String         @db.Uuid
  fromStatus ArticleStatus?
  toStatus   ArticleStatus
  actorId    String?        @db.Uuid
  actorRole  Role?
  reason     String?
  requestId  String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
}

// ───────────────────────────── Peer review ─────────────────────────────

model ReviewerAssignment {
  id             String                   @id @default(uuid()) @db.Uuid
  articleId      String                   @db.Uuid
  reviewerId     String                   @db.Uuid
  versionId      String                   @db.Uuid
  slot           Int // 1 or 2 — stable anonymous label (Reviewer A / B) for author-facing output
  status         ReviewerAssignmentStatus @default(ASSIGNED)
  assignedById   String                   @db.Uuid
  dueDate        DateTime?                @db.Timestamptz(6)
  assignedAt     DateTime                 @default(now()) @db.Timestamptz(6)
  respondedAt    DateTime?                @db.Timestamptz(6)
  declineReason  String?
  lastReminderAt DateTime?                @db.Timestamptz(6)
  endedAt        DateTime?                @db.Timestamptz(6)

  article  Article           @relation(fields: [articleId], references: [id], onDelete: Restrict)
  reviewer ReviewerProfile   @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  version  ManuscriptVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  report   ReviewReport?
  // A reviewer can hold only one live assignment per article, and each slot only one live assignment.

  @@index([articleId, status])
  @@index([reviewerId, status])
}

model ReviewReport {
  id             String                @id @default(uuid()) @db.Uuid
  assignmentId   String                @unique @db.Uuid
  status         ReviewReportStatus    @default(DRAFT)
  recommendation ReviewRecommendation?
  submittedAt    DateTime?             @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)

  assignment ReviewerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  comments   ReviewComment[]
}

model ReviewComment {
  id                String               @id @default(uuid()) @db.Uuid
  reportId          String               @db.Uuid
  section           ReviewCommentSection
  body              String
  orderIndex        Int                  @default(0)
  approvedForAuthor Boolean              @default(false)
  editedBody        String? // editor-moderated wording shown to the author instead of body
  approvedById      String?              @db.Uuid
  approvedAt        DateTime?            @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)

  report ReviewReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
}

model EditorialDecision {
  id            String        @id @default(uuid()) @db.Uuid
  articleId     String        @db.Uuid
  decision      DecisionType
  fromStatus    ArticleStatus
  toStatus      ArticleStatus
  notes         String? // internal editorial notes
  authorMessage String? // optional message deliberately addressed to the author
  decidedById   String        @db.Uuid
  decidedAt     DateTime      @default(now()) @db.Timestamptz(6)

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  decidedBy User    @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([articleId, decidedAt])
}

model PlagiarismCheck {
  id                String             @id @default(uuid()) @db.Uuid
  articleId         String             @db.Uuid
  versionId         String             @db.Uuid
  status            PlagiarismStatus   @default(PENDING)
  source            PlagiarismSource
  provider          String?
  providerReference String?            @unique
  similarityScore   Decimal?           @db.Decimal(5, 2)
  verdict           PlagiarismVerdict?
  reportFileId      String?            @unique @db.Uuid
  notes             String?
  errorMessage      String?
  /// Detailed report from the built-in engine (internalScore, webScore, matchedSources).
  report            Json?
  initiatedById     String             @db.Uuid
  completedAt       DateTime?          @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  article    Article           @relation(fields: [articleId], references: [id], onDelete: Restrict)
  version    ManuscriptVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  reportFile FileAsset?        @relation(fields: [reportFileId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
}

// ───────────────────────────── APC / payment ─────────────────────────────

model ApcPayment {
  id                String        @id @default(uuid()) @db.Uuid
  articleId         String        @unique @db.Uuid
  amount            Decimal?      @db.Decimal(12, 2)
  currency          String?       @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?       @unique
  paidAt            DateTime?     @db.Timestamptz(6)
  note              String?
  recordedById      String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([status])
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  processedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([provider, eventId])
}

// ───────────────────────────── Production & publication ─────────────────────────────

model ProductionTask {
  id           String               @id @default(uuid()) @db.Uuid
  articleId    String               @unique @db.Uuid
  assignedToId String?              @db.Uuid
  status       ProductionTaskStatus @default(PENDING)
  notes        String?
  startedAt    DateTime?            @db.Timestamptz(6)
  completedAt  DateTime?            @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)

  article    Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  assignedTo User?   @relation("ProductionAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([assignedToId, status])
  @@index([status])
}

model ProofVersion {
  id                String            @id @default(uuid()) @db.Uuid
  articleId         String            @db.Uuid
  versionNumber     Int
  fileId            String            @unique @db.Uuid
  notes             String?
  uploadedById      String            @db.Uuid
  sentToAuthorAt    DateTime?         @db.Timestamptz(6)
  authorStatus      ProofAuthorStatus @default(PENDING_DELIVERY)
  authorRespondedAt DateTime?         @db.Timestamptz(6)
  authorFeedback    String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)

  article     Article      @relation(fields: [articleId], references: [id], onDelete: Restrict)
  file        FileAsset    @relation(fields: [fileId], references: [id], onDelete: Restrict)
  corrections Correction[]

  @@unique([articleId, versionNumber])
}

model Correction {
  id                String           @id @default(uuid()) @db.Uuid
  articleId         String           @db.Uuid
  proofId           String           @db.Uuid
  type              CorrectionType   @default(MINOR)
  status            CorrectionStatus @default(OPEN)
  location          String?
  description       String
  requestedById     String           @db.Uuid
  implementedById   String?          @db.Uuid
  implementedAt     DateTime?        @db.Timestamptz(6)
  productionNote    String?
  escalatedAt       DateTime?        @db.Timestamptz(6)
  editorDecidedById String?          @db.Uuid
  editorDecidedAt   DateTime?        @db.Timestamptz(6)
  editorNote        String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  article Article      @relation(fields: [articleId], references: [id], onDelete: Restrict)
  proof   ProofVersion @relation(fields: [proofId], references: [id], onDelete: Restrict)

  @@index([articleId, status])
  @@index([status])
}

model Publication {
  id            String            @id @default(uuid()) @db.Uuid
  articleId     String            @unique @db.Uuid
  status        PublicationStatus @default(DRAFT)
  htmlFileId    String?           @unique @db.Uuid
  pdfFileId     String?           @unique @db.Uuid
  publishedAt   DateTime?         @db.Timestamptz(6)
  publishedById String?           @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)

  article  Article              @relation(fields: [articleId], references: [id], onDelete: Restrict)
  htmlFile FileAsset?           @relation("PublicationHtml", fields: [htmlFileId], references: [id], onDelete: Restrict)
  pdfFile  FileAsset?           @relation("PublicationPdf", fields: [pdfFileId], references: [id], onDelete: Restrict)
  metadata PublicationMetadata?

  @@index([status, publishedAt])
}

model PublicationMetadata {
  id            String   @id @default(uuid()) @db.Uuid
  publicationId String   @unique @db.Uuid
  doi           String?  @unique
  volume        String?
  issue         String?
  pages         String?
  license       String?
  copyright     String?
  citation      String?
  extra         Json?
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
}

// ───────────────────────────── Notifications / audit / config ─────────────────────────────

model Notification {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  type          String
  title         String
  message       String
  entityType    String?
  entityId      String?
  dedupeKey     String
  readAt        DateTime?   @db.Timestamptz(6)
  emailStatus   EmailStatus @default(PENDING)
  emailAttempts Int         @default(0)
  emailError    String?
  emailSentAt   DateTime?   @db.Timestamptz(6)
  emailTemplate String?
  emailPayload  Json?
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([emailStatus, updatedAt])
}

// Append-only. A trigger created in the initial migration rejects UPDATE/DELETE/TRUNCATE.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  fromStatus String?
  toStatus   String?
  metadata   Json?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model SystemConfig {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)
}

model Sequence {
  name  String @id
  value Int    @default(0)
}
