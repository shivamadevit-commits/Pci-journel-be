# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME="PCI Journal Portal"
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for client IPs (0 = none, 1 = single OCI load balancer).
# Never set to "true". A comma-separated list of CIDRs / names ("loopback, 10.0.0.0/8") is also accepted.
TRUST_PROXY=0
JSON_BODY_LIMIT=100kb
SWAGGER_ENABLED=true

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://USER:root@HOST:5432/DBNAME?schema=public"

# ── CORS / frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed origins. Defaults to FRONTEND_URL when empty.
CORS_ORIGIN=

# ── JWT / sessions ───────────────────────────────────────────
# Access tokens are signed JWTs (HS256). Refresh tokens are opaque, hashed in the DB, rotated on use.
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=pci-journal-portal
JWT_AUDIENCE=pci-journal-portal-clients
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_COST=12

# ── Authentication policy ────────────────────────────────────
LOGIN_OTP_REQUIRED=true
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRY_MINUTES=30
INVITE_EXPIRY_HOURS=72

# ── Rate limiting (window in ms) ─────────────────────────────
# Set REDIS_URL for a shared store when running more than one instance (e.g. on OCI).
REDIS_URL=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
OTP_VERIFY_RATE_LIMIT_WINDOW_MS=900000
OTP_VERIFY_RATE_LIMIT_MAX=10
OTP_RESEND_RATE_LIMIT_WINDOW_MS=900000
OTP_RESEND_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=10
REVIEWER_APPLICATION_RATE_LIMIT_WINDOW_MS=3600000
REVIEWER_APPLICATION_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=60

# ── Email (Nodemailer / SMTP) ────────────────────────────────
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-username
SMTP_PASS=smtp-password
EMAIL_FROM="PCI Journal Portal <no-reply@example.com>"
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_INTERVAL_SECONDS=120

# ── File storage ─────────────────────────────────────────────
# local (development) | oci (OCI Object Storage via its S3-compatible API)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data
OCI_OS_NAMESPACE=
OCI_OS_REGION=
OCI_OS_BUCKET=
OCI_OS_ACCESS_KEY_ID=
OCI_OS_SECRET_ACCESS_KEY=
# Optional override. Default: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_OS_ENDPOINT=
MAX_UPLOAD_MB=25
# Standard submission format is Microsoft Word. Only .docx can be validated and word-counted.
MANUSCRIPT_ALLOWED_EXTENSIONS=docx

# ── Journal rules (also editable at runtime via /admin/config) ──
SUBMISSION_ID_PREFIX=PCI
WORD_LIMIT=5000
# none | flag | block  (block = screening cannot start until APC is PAID or WAIVED)
APC_ENFORCEMENT=flag
# Leave empty until PCI confirms the APC amount / currency.
APC_DEFAULT_AMOUNT=
APC_CURRENCY=
# Revision after peer review is NOT enabled until PCI confirms the rule.
ALLOW_REVISION_AFTER_REVIEW=false
# Leave empty until PCI confirms review deadlines.
REVIEW_DUE_DAYS=
REVIEWER_MIN_YEARS_TEACHING=10
# Comma-separated PublicationMetadata fields that must be set before publishing (e.g. doi,volume,issue).
PUBLICATION_REQUIRED_METADATA=

# ── Payment provider ─────────────────────────────────────────
# none | cashfree
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Cashfree (PAYMENT_PROVIDER=cashfree). The secret key also signs webhooks.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# SANDBOX | PRODUCTION
CASHFREE_ENV=SANDBOX
# Optional host override (default derived from CASHFREE_ENV)
CASHFREE_BASE_URL=
CASHFREE_API_VERSION=2023-08-01
# Where the author lands after paying. Default: <FRONTEND_URL>/author/articles/<id>?payment=return&order_id={order_id}
CASHFREE_RETURN_URL=
# Public URL of POST /api/v1/webhooks/payments (omit to use the URL configured in the Cashfree dashboard)
CASHFREE_NOTIFY_URL=
CASHFREE_TIMEOUT_MS=15000
# Used when the author profile has no valid 10-digit phone (Cashfree requires one)
CASHFREE_FALLBACK_PHONE=9999999999

# ── Plagiarism provider (PCI to confirm) ─────────────────────
PLAGIARISM_PROVIDER=none
PLAGIARISM_API_BASE_URL=
PLAGIARISM_API_KEY=
PLAGIARISM_WEBHOOK_SECRET=

# ── Built-in plagiarism engine ───────────────────────────────
# Layer 1 (internal DB comparison) always runs. Layer 2 (web) needs a search provider: none | brave
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
PLAGIARISM_INTERNAL_CORPUS_LIMIT=2000
PLAGIARISM_WEB_MAX_QUERIES=8
PLAGIARISM_WEB_MAX_PAGES=10
PLAGIARISM_FETCH_TIMEOUT_MS=10000

# ── Seed (first Chief Editor / Admin; used only by `npm run seed`) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Immediately-123!
SEED_ADMIN_FIRST_NAME=Portal
SEED_ADMIN_LAST_NAME=Admin
